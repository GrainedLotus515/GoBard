# Set exactly one credential source. Keep a real .env file mode 0600.
DISCORD_TOKEN=your_discord_bot_token_here
# For docker-compose.secrets.yml, comment DISCORD_TOKEN and set this host path:
# DISCORD_TOKEN_FILE_HOST=/absolute/path/to/discord-token
# Make that file readable by container UID 1000 (for example, owner 1000:1000 and mode 0400).

# Cache settings
CACHE_DIR=./cache
CACHE_LIMIT=2GB

# Bot appearance
BOT_STATUS=online          # Possible values: online, idle, dnd, invisible
BOT_ACTIVITY_TYPE=LISTENING  # Possible values: PLAYING, LISTENING, STREAMING, WATCHING
BOT_ACTIVITY=music          # Text displayed for the activity
BOT_ACTIVITY_URL=           # Optional URL for STREAMING activity

# Command registration: false reconciles commands per guild; true uses global commands.
REGISTER_COMMANDS_ON_BOT=false

# Playback
DEFAULT_VOLUME=100                  # Integer from 0 to 100
REDUCE_VOL_WHEN_VOICE=false         # Reduce volume when users speak
REDUCE_VOL_WHEN_VOICE_TARGET=70     # Integer from 0 to 100
MAX_PLAYLIST_TRACKS=500              # Integer from 1 to 500
YTDLP_MAX_CONCURRENCY=4              # Shared yt-dlp cap: metadata, playlist work, cache downloads, and streaming fallback (1-16)

# Health listener (must be a loopback address)
HEALTH_LISTEN_ADDR=127.0.0.1:8080

# Debug
DEBUG=false                  # Enable debug logging, ms timestamps, and /play startup trace logs
DEBUG_PLAYBACK=false         # Enable playback diagnostics for buffer and frame timing
